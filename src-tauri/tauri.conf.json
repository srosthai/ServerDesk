{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerDesk",
  "version": "0.1.0",
  "identifier": "com.serverdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ServerDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ServerDesk",
    "copyright": "Copyright © 2026 ServerDesk contributors",
    "homepage": "https://github.com/srosthai/ServerDesk",
    "category": "DeveloperTool",
    "shortDescription": "Manage Linux VPS servers over SSH.",
    "longDescription": "ServerDesk is a local-first desktop workspace for connecting to Linux VPS servers over SSH, inspecting system health, managing services, running Laravel tasks, and working with remote files.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQ0I4M0YyRTU2ODgwMUUKUldRZWdHamw4b1BMTTI2TTl3Tno4cDdpY3BLLzhTK29NTERYZndBWW5CUDVqUThjUTZJTVdpNlEK",
      "endpoints": ["https://github.com/srosthai/ServerDesk/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
